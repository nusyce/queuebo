###############################################################################
# Copy to .env.docker and adjust. docker compose reads this file directly and
# the entrypoint copies it to .env inside the container on first boot.
###############################################################################

APP_NAME=Queuebo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_INSTALLED=false
APP_DEMO=false
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Host port the web container is published on -----------------------
APP_PORT=8080

# --- Database (service name "mysql" on the compose network) ----------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=queuebo
DB_USERNAME=queuebo
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_FORWARD_PORT=33061

# --- Redis (service name "redis") ---------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=63791

# --- Queue / cache / session (match Stackposts production defaults) --
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=queuebo_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (optional) ------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Headless install (pre-configured DB, no web wizard) -------------
# true  = on first boot run `artisan queuebo:install`: migrate + seed +
#         create the administrator from the ADMIN_* vars below, then flip
#         APP_INSTALLED=true. Idempotent; skips itself once installed.
# false = use the /installer web wizard instead.
AUTO_INSTALL=true
# The wizard verifies an Envato purchase code against stackposts.com.
# false lets both the wizard and queuebo:install run fully offline.
INSTALLER_PURCHASE_CODE_REQUIRED=false

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Leave blank to have a strong password generated and printed to the logs.
ADMIN_PASSWORD=
SITE_DESCRIPTION=
SITE_KEYWORDS=

# --- Entrypoint behaviour ------------------------------------------
WAIT_FOR_DB=true
# queue/scheduler containers hold until the Stackposts schema exists
# (i.e. until you finish /installer). Set false only if you know the
# database is already migrated.
WAIT_FOR_INSTALL=true
# false = let the /installer web wizard create the schema on first run.
# true  = run `artisan migrate --force` at boot (already-installed DB).
RUN_MIGRATIONS=false
# false during setup; true in steady-state prod to cache config/views
# (a container restart is then required to pick up .env changes).
OPTIMIZE=false
# true to run composer install at build time (app/ without vendor/).
RUN_COMPOSER_INSTALL=false
