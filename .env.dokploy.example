###############################################################################
# Queuebo on Dokploy — paste into the service's Environment tab, then edit.
# Dokploy feeds these into docker-compose.dokploy.yml at deploy time.
# Anything omitted falls back to the default baked into that compose file.
###############################################################################

# --- required ---------------------------------------------------------------
APP_DOMAIN=queuebo.example.com
# Generate once and keep it stable (changing it invalidates sessions and
# any encrypted columns):
#   php artisan key:generate --show
#   # or, with the built image:
#   docker run --rm queuebo:dokploy php artisan key:generate --show
APP_KEY=base64:REPLACE_ME

# --- MySQL + Redis: Dokploy NATIVE Database services ---------------------
# Created in the Dokploy UI (Create Service > Database), NOT in this compose.
# DB_HOST / REDIS_HOST = the "Internal Host" shown in each database's
# "Internal Connection" section — a name Dokploy assigns, not a fixed one.
# The app / queue / scheduler containers reach it over "dokploy-network".
# Create a dedicated db + user first (Dokploy > MySQL > Execute SQL):
#   CREATE DATABASE queuebo CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'queuebo'@'%' IDENTIFIED BY 'a-strong-password';
#   GRANT ALL PRIVILEGES ON queuebo.* TO 'queuebo'@'%';
DB_HOST=change-me-mysql-internal-host
DB_PORT=3306
DB_PASSWORD=change-me-to-something-strong
REDIS_HOST=change-me-redis-internal-host
REDIS_PORT=6379
# The password from the Dokploy Redis page. Use "null" only if it has no auth.
REDIS_PASSWORD=change-me-redis-password

# --- first-boot install (headless, no web wizard) -------------------------
AUTO_INSTALL=true
INSTALLER_PURCHASE_CODE_REQUIRED=false
ADMIN_NAME=Administrator
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
# Blank -> a strong password is generated and printed to the app log
# (Dokploy: service > Logs, filter the "app" container).
ADMIN_PASSWORD=

# --- steady-state production --------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
OPTIMIZE=true
SESSION_SECURE_COOKIE=true
LOG_LEVEL=error

# --- database / cache identifiers (defaults shown) --------------------
DB_DATABASE=queuebo
DB_USERNAME=queuebo
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- mail (swap log -> smtp for real delivery) ----------------------
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@queuebo.example.com

# --- S3 media storage (optional) -----------------------------------
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
