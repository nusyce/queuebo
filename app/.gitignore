# Trimmed for this deployment repo: vendor/ and public/build/ ARE committed
# (self-contained image build — no composer/npm step, and the frontend has no
# buildable sources in the package). Only true local state is ignored here.

/node_modules
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*.php
/bootstrap/cache/*.php
.env
.env.backup
.env.production
/auth.json
/.phpunit.cache
/.phpunit.result.cache
/.phpactor.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed
